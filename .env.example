# ─── AI (server-side only, never exposed to the browser) ────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used for the reading companion. The default was benchmarked for
# time-to-first-token, which is what a voice question actually feels like:
#   gemini-3.5-flash-lite  ~0.9-1.9s   <- default, and easiest on a free key
#   gemini-3.5-flash       ~2.7s
#   gemini-3.6-flash       ~4.9s       most capable, noticeably slower to start
FOLIO_AI_MODEL=gemini-3.5-flash-lite

# ─── Supabase (postgres + file storage) ────────────────────────────────────
# Create a project at https://supabase.com, then run supabase/schema.sql in the
# SQL editor. Leave these blank to run on the local file-backed adapter
# (development only — data lives in ./.data).
#
# Only these two are needed. Nothing in the browser talks to Supabase directly,
# so there is no anon/publishable key to set.
#   URL          Project Settings -> Data API -> Project URL
#   SERVICE KEY  Project Settings -> API Keys -> service_role  (secret — server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Session signing ───────────────────────────────────────────────────────
# Any long random string. Generate: openssl rand -base64 48
SESSION_SECRET=

# ─── Text to speech (optional) ─────────────────────────────────────────────
# Applies to spoken AI replies only. Page narration always uses the browser's
# own synthesis, because the reading highlight is driven by its real-time
# sentence boundaries and recorded audio can't report those.
#
# Supported: "browser" (default) | "gemini" | "openai" | "elevenlabs"
#
#   gemini      Speaks through GEMINI_API_KEY — no extra key, and free-tier
#               eligible. Streamed, so the first words play about two seconds
#               after the answer lands rather than after the whole reply is
#               generated (which takes 14-17s).
#   openai      Set TTS_API_KEY. Voices: alloy, nova, shimmer, …
#   elevenlabs  Set TTS_API_KEY. TTS_VOICE is a voice id.
TTS_PROVIDER=browser
# Only needed for openai/elevenlabs; gemini falls back to GEMINI_API_KEY.
TTS_API_KEY=
# Gemini prebuilt voice name: Kore (even, clear), Puck (brighter), Charon
# (deeper), Aoede, Fenrir, Zephyr, and others in the speech-generation docs.
TTS_VOICE=
# Overrides the TTS model; the gemini default is gemini-3.1-flash-tts-preview.
TTS_MODEL=
